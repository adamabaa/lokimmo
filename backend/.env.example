# ============================================================
#  LOKIMMO Backend — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ============================================================

# Base de données
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=lokimmo

# Application
APP_ENV=local
APP_URL=http://localhost/lokimmo/backend/public
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=
JWT_SECRET_SUPER_ADMIN=

# Email (PHPMailer)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Lokimmo

# SMS (Africa's Talking)
AT_USERNAME=
AT_API_KEY=

# Paiement (CinetPay)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=